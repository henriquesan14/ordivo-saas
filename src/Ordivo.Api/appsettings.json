{
  "ConnectionStrings": {
    "OrdivoDatabase": "Host=localhost;Port=5432;Database=ordivo;Username=postgres"
  },
  "Jwt": {
    "Issuer": "Ordivo",
    "Audience": "Ordivo.Web",
    "AccessTokenExpirationMinutes": 15
  },
  "RefreshToken": {
    "ExpirationDays": 30
  },
  "AuthCookie": {
    "Name": "ordivo.access_token",
    "RefreshName": "ordivo.refresh_token",
    "Secure": true,
    "SameSite": "Strict"
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "GlobalPermitLimit": 120,
    "AuthenticationPermitLimit": 5,
    "RefreshPermitLimit": 20,
    "IdentityPermitLimit": 10,
    "WindowSeconds": 60
  },
  "DataProtection": {
    "KeysPath": ".keys"
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "FromEmail": "no-reply@ordivo.local",
    "FromName": "Ordivo",
    "FrontendBaseUrl": "http://localhost:4200"
  },
  "PlatformAdmin": {
    "Name": "",
    "Email": "",
    "Password": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
